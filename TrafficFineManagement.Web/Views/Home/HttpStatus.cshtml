@model int
@{
    ViewData["Title"] = "Hata";
    var (title, message) = Model switch
    {
        404 => ("Sayfa bulunamadı", "Aradığınız kayıt veya sayfa mevcut değil."),
        403 => ("Erişim engellendi", "Bu işlem için yetkiniz bulunmuyor."),
        _ => ("Bir hata oluştu", "İşleminiz şu anda gerçekleştirilemiyor.")
    };
}

<div class="text-center py-5">
    <div class="display-1 text-muted">@Model</div>
    <h2>@title</h2>
    <p class="text-muted">@message</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Ana Sayfaya Dön</a>
</div>