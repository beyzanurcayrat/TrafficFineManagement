@model Dictionary<FineStatus, int>
@{
    ViewData["Title"] = "Ana Sayfa";
    var myRoles = AppRoles.DisplayNames.Where(r => User.IsInRole(r.Key)).Select(r => r.Value);
}

<h2 class="mb-1">Trafik Cezası Yönetimi</h2>
<p class="text-muted mb-4">Rolünüz: @string.Join(", ", myRoles)</p>

<div class="row g-3 mb-4">
    @foreach (var (status, count) in Model)
    {
        <div class="col-6 col-md">
            <a asp-controller="Fines" asp-action="Index" asp-route-status="@status" class="text-decoration-none text-reset">
                <div class="card text-center h-100 shadow-sm">
                    <div class="card-body">
                        <span class="badge @status.GetBadgeClass() mb-2">@status.GetDisplayName()</span>
                        <div class="display-6">@count</div>
                    </div>
                </div>
            </a>
        </div>
    }
</div>

<div class="d-flex gap-2">
    @if (User.IsInRole(AppRoles.Personnel))
    {
        <a asp-controller="Fines" asp-action="Create" class="btn btn-primary">+ Yeni Ceza</a>
    }
    @if (User.IsInRole(AppRoles.Manager) || User.IsInRole(AppRoles.Finance))
    {
        <a asp-controller="Fines" asp-action="Pending" class="btn btn-warning">Onayımı Bekleyenler</a>
    }
    @if (User.IsInRole(AppRoles.Admin))
    {
        <a asp-controller="Users" asp-action="Index" class="btn btn-outline-primary">Kullanıcı Yönetimi</a>
    }
    <a asp-controller="Fines" asp-action="Index" class="btn btn-outline-secondary">Tüm Cezalar</a>
</div>