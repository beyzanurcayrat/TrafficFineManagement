@model FineDetailDto
@{
    ViewData["Title"] = $"Ceza {Model.FineNumber}";
    var lastRejection = Model.History.LastOrDefault(h => h.ActionType == ApprovalActionType.Rejected);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>
        Ceza @Model.FineNumber
        <span class="badge @Model.Status.GetBadgeClass() fs-6 align-middle">@Model.Status.GetDisplayName()</span>
    </h2>
    <a asp-action="Index" class="btn btn-outline-secondary">← Listeye dön</a>
</div>

<partial name="_Alerts" />

@if (Model.Status == FineStatus.Rejected && lastRejection is not null)
{
    <div class="alert alert-danger">
        <strong>Ret nedeni:</strong> @lastRejection.Note
        <div class="small">@lastRejection.UserName, @lastRejection.Date.ToLocalTime().ToTrDateTime()</div>
    </div>
}

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header">Ceza Bilgileri</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Plaka</dt>
                    <dd class="col-sm-8">@Model.Plate.FormatPlate() <span class="text-muted">(@Model.VehicleInfo)</span></dd>

                    <dt class="col-sm-4">İhlal Türü</dt>
                    <dd class="col-sm-8">@Model.ViolationType</dd>

                    <dt class="col-sm-4">İhlal Tarihi</dt>
                    <dd class="col-sm-8">@Model.ViolationDate.ToTrDateTime()</dd>

                    <dt class="col-sm-4">Yer</dt>
                    <dd class="col-sm-8">@(Model.Location ?? "-")</dd>

                    <dt class="col-sm-4">Tutar</dt>
                    <dd class="col-sm-8 fw-bold">@Model.Amount.ToMoney()</dd>

                    <dt class="col-sm-4">Açıklama</dt>
                    <dd class="col-sm-8">@(Model.Description ?? "-")</dd>

                    <dt class="col-sm-4">Oluşturan</dt>
                    <dd class="col-sm-8">@Model.CreatedBy, @Model.CreatedAt.ToLocalTime().ToTrDateTime()</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card">
            <div class="card-header">İşlemler</div>
            <div class="card-body">
                @if (!Model.CanEdit && !Model.CanSubmit && !Model.CanDecide)
                {
                    <p class="text-muted mb-0">Bu kayıt üzerinde yapabileceğiniz bir işlem bulunmuyor.</p>
                }

                @if (Model.CanEdit)
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary mb-2">Düzenle</a>
                }

                @if (Model.CanSubmit)
                {
                    <form asp-action="Submit" asp-route-id="@Model.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-primary mb-2">Onaya Gönder</button>
                    </form>
                }

                @if (Model.CanDecide)
                {
                    <form asp-action="Approve" asp-route-id="@Model.Id" method="post" class="mb-3">
                        <label class="form-label" for="note">Açıklama (opsiyonel)</label>
                        <textarea id="note" name="note" rows="2" maxlength="500" class="form-control mb-2"></textarea>
                        <button type="submit" class="btn btn-success">Onayla</button>
                    </form>

                    <form asp-action="Reject" asp-route-id="@Model.Id" method="post">
                        <label class="form-label" for="reason">Ret nedeni <span class="text-danger">*</span></label>
                        <textarea id="reason" name="reason" rows="2" maxlength="500" required class="form-control mb-2"></textarea>
                        <button type="submit" class="btn btn-danger">Reddet</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

<h4 class="mt-4">Onay Geçmişi</h4>
<table class="table table-sm table-bordered align-middle">
    <thead class="table-light">
        <tr>
            <th>Tarih</th>
            <th>Kullanıcı</th>
            <th>İşlem</th>
            <th>Önceki Durum</th>
            <th>Yeni Durum</th>
            <th>Açıklama / Ret Nedeni</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var h in Model.History)
        {
            <tr>
                <td>@h.Date.ToLocalTime().ToTrDateTime()</td>
                <td>@h.UserName</td>
                <td>@h.ActionType.GetDisplayName()</td>
                <td>@(h.FromStatus?.GetDisplayName() ?? "-")</td>
                <td>@h.ToStatus.GetDisplayName()</td>
                <td>@(h.Note ?? "-")</td>
            </tr>
        }
    </tbody>
</table>