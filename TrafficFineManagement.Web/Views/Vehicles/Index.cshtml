@model List<VehicleListItemDto>
@{
    ViewData["Title"] = "Araçlar";
    var canManageVehicles = User.IsInRole(AppRoles.Personnel) || User.IsInRole(AppRoles.Manager);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Araçlar</h2>
    @if (canManageVehicles)
    {
        <a asp-action="Create" class="btn btn-primary">+ Yeni Araç</a>
    }
</div>

<partial name="_Alerts" />

@if (!Model.Any())
{
    <p class="text-muted">Henüz araç eklenmemiş.</p>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
        <tr>
            <th>Plaka</th>
            <th>Araç Tipi</th>
            <th>Marka</th>
            <th>Model</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var vehicle in Model)
        {
            <tr>
                <td>@vehicle.Plate.FormatPlate()</td>
                <td>@vehicle.VehicleType.GetDisplayName()</td>
                <td>@vehicle.Brand</td>
                <td>@vehicle.Model</td>
                <td class="text-end">
                    @if (canManageVehicles)
                    {
                        <a asp-action="Edit" asp-route-id="@vehicle.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                        <form asp-action="Delete" asp-route-id="@vehicle.Id" method="post" class="d-inline"
                              onsubmit="return confirm('@vehicle.Plate.FormatPlate() plakalı aracı silmek istediğinize emin misiniz?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
}