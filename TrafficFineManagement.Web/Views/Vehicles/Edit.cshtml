@model VehicleFormDto
@{
    ViewData["Title"] = "Araç Düzenle";
}

<h2>Araç Düzenle</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" asp-route-id="@ViewData["VehicleId"]" method="post">
            <partial name="_VehicleForm" model="Model" />
            <button type="submit" class="btn btn-primary">Güncelle</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}