@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<div class="text-center py-5">
    <div class="display-1 text-muted">500</div>
    <h2>Beklenmeyen bir hata oluştu</h2>
    <p class="text-muted">İşleminiz gerçekleştirilemedi. Lütfen daha sonra tekrar deneyin.</p>
    @if (Model?.ShowRequestId ?? false)
    {
        <p class="small text-muted">Hata kodu: <code>@Model.RequestId</code></p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Ana Sayfaya Dön</a>
</div>